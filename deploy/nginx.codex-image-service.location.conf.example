# Drop-in nginx config for serving codex-image-service behind an existing
# nginx (Docker or otherwise) that already terminates TLS for your domain.
#
# 1) Put the limit_req_zone directive once at http-context scope (top of
#    your main conf, alongside any other geo / map blocks):
#
#    limit_req_zone $binary_remote_addr zone=codeximg_login:10m rate=6r/m;
#
# 2) Paste the three location blocks below into the server block that
#    serves your public domain (HTTPS, with cert already provisioned).
#
# Assumes nginx and codex-image-service share a Docker network so nginx can
# resolve "codex-image-service" as a hostname. If you run nginx outside
# Docker, replace `codex-image-service` with `127.0.0.1` and expose port
# 8000 on the host side instead.
#
# After editing the nginx config:
#   nginx -t && nginx -s reload

# admin/login — brute-force throttled
location = /codex-image/admin/login {
    limit_req zone=codeximg_login burst=5 nodelay;
    rewrite ^/codex-image/(.*)$ /$1 break;
    proxy_pass http://codex-image-service:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
}

# admin/* — relies on app-side session + strong ADMIN_PASSWORD
location ~ ^/codex-image/admin {
    rewrite ^/codex-image/(.*)$ /$1 break;
    proxy_pass http://codex-image-service:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
}

# Public API + generated images — strip /codex-image/ via trailing slash on proxy_pass
location /codex-image/ {
    client_max_body_size 20m;
    proxy_pass http://codex-image-service:8000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 650s;
    proxy_read_timeout 650s;
}
