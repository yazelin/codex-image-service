# Multi-account round-robin (optional). When set, the service rotates
# CODEX_HOME between the listed paths so each request hits a different
# ChatGPT subscription. Each path is the location *inside the container*;
# the host parent dir is mounted at /host_codex_homes by docker-compose.
#   Example for two accounts (personal + team), set up by running
#     mkdir -p ~/codex-homes/{personal,team}
#     CODEX_HOME=~/codex-homes/personal codex login
#     CODEX_HOME=~/codex-homes/team     codex login
#   then:
#     CODEX_HOMES=/host_codex_homes/personal:/host_codex_homes/team
# Add as many `:`-separated entries as you have accounts.
# Leave empty to use a single account at the container's default ~/.codex.
CODEX_HOMES=

ADMIN_USERNAME=admin
# Pick a strong password — admin holds the API key issuer.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-this-session-secret
# Set when serving behind nginx at a sub-path so admin URLs include it.
# Example for prod: ADMIN_URL_PREFIX=/codex-image
ADMIN_URL_PREFIX=
DATABASE_URL=sqlite:///./data/app.db
GENERATED_DIR=static/generated
# When behind nginx, set this to the externally-visible base URL including
# the path prefix. Example: PUBLIC_BASE_URL=https://images.example.com/codex-image
PUBLIC_BASE_URL=http://localhost:8000
# gpt-image-2 real-world: 70-180s typical, 145-175s for harder prompts.
# 360s gives generous headroom for edits and multi-step reasoning.
# Must stay below REQUEST_WAIT_TIMEOUT_SECONDS and nginx proxy_read_timeout.
CODEX_TIMEOUT_SECONDS=360
CODEX_WORKDIR=./data/codex-runs
CODEX_WORKER_CONCURRENCY=2
GENERATION_QUEUE_MAX_SIZE=50
REQUEST_WAIT_TIMEOUT_SECONDS=600
IMAGE_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=6

